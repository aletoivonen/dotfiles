layout {
    background-color "transparent"

    focus-ring {
        active-color   "#ffb3ad"
        inactive-color "#a48b88"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb3ad"
        inactive-color "#a48b88"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb3ad"
        inactive-color "#a48b88"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb3ad80"
    }
}

recent-windows {
    highlight {
        active-color   "#e26d67"
        urgent-color   "#ffb4ab"
    }
}