# Hyprland Configuration
# https://wiki.hypr.land/Configuring/

# ==================
# MONITOR CONFIG
# ==================
# Monitors from existing configuration
# monitor=,preferred,auto,auto
#monitor = eDP-1, 1920x1080, auto, 1
monitor = DP-2, 2560x1440@143.97, auto, 1
monitor = HDMI-A-1, 1920x1080, auto-left, 1, transform, 3
monitor = HDMI-A-2, 2560x1440@120, auto-right, 1

monitor = , preferred,auto,auto

# ==================
# STARTUP APPS
# ==================
exec-once = dbus-update-activation-environment --systemd --all
exec-once = systemctl --user start hyprland-session.target
exec-once = bash -c "wl-paste --watch cliphist store &"
exec-once = hyprpm reload -n

# source = ~/.config/hypr/myColors.conf
# source = ~/.config/hypr/workspaces.conf

# ===============
# VARIABLES
# ===============


# ==================
# INPUT CONFIG
# ==================
input {
    kb_layout = fi
    numlock_by_default = true

    follow_mouse = 1
    mouse_refocus = false

    sensitivity = -0.4 # -1.0 - 1.0, 0 means no modification.

    touchpad {
        natural_scroll = true
    }
}

device {
  name = elan0511:01-04f3:303f-touchpad
  sensitivity = 0.15
}

debug {
disable_logs = false

}

# ==================
# GENERAL LAYOUT
# ==================
general {
    gaps_in = 3
    gaps_out = 3
    border_size = 5  # off in niri

    col.active_border = rgba(fab387ff)
    col.inactive_border = rgba(595959ff)

    resize_on_border = false

    layout = scrolling

}


# ==================
# DECORATION
# ==================
decoration {
    rounding = 2

    active_opacity = 1.0
    #inactive_opacity = 0.85

    shadow {
        enabled = false
        range = 4
        render_power = 5
        offset = 0 5
        color = rgba(00000070)
    }
}

# ==================
# ANIMATIONS
# ==================
animations {
    enabled = true

    animation = windowsIn, 1, 3, default
    animation = windowsOut, 1, 3, default
    animation = workspaces, 1, 5, default, slidevert
    animation = windowsMove, 1, 4, default
    animation = fade, 1, 3, default
    animation = border, 1, 3, default
}

# ==================
# LAYOUTS
# ==================
master {
    mfact = 0.5
}

scrolling {
  fullscreen_on_one_column = true
  column_width = 0.5
  focus_fit_method = 1
  follow_focus = true
  explicit_column_widths = "0.2, 0.333, 0.5, 0.667, 0.900, 1.0"
  # follow_min_visible = 0.0
}

# ==================
# MISC
# ==================
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    vrr = 1
    middle_click_paste = false
}

# ==================
# WINDOW RULES
# ==================
windowrule = match:class ^(org\.wezfurlong\.wezterm)$, tile true

windowrule = match:class ^(org\.gnome\.), rounding = 12
windowrule = match:class ^(org\.gnome\.) border_size = 0
windowrule = match:class ^(gnome-control-center)$, tile = true
windowrule = match:class ^(pavucontrol)$, tile = true
windowrule = match:class ^(nm-connection-editor)$, tile = true

windowrule = match:class ^(gnome-calculator)$, float = true
windowrule = match:class ^(galculator)$, float = true
windowrule = match:class ^(blueman-manager)$, float = true
windowrule = match:class ^(org\.gnome\.Nautilus)$, float = true
#windowrule = match:class ^(steam)$, float = true
windowrule = match:class ^(xdg-desktop-portal)$, float = true

windowrule = match:class ^(org\.wezfurlong\.wezterm)$, border_size = 0
windowrule = match:class ^(Kitty)$, border_size = 0
windowrule = match:class ^(zen)$, border_size = 0
windowrule = match:class ^(com\.mitchellh\.ghostty)$, border_size = 0
windowrule = match:class ^(kitty)$, border_size = 0

windowrule = match:class ^(firefox)$, match:title ^(Picture-in-Picture)$, float = true
windowrule = match:class ^(zoom)$, float = true

# DMS windows floating by default
windowrule = match:class ^(org.quickshell)$, float = true
windowrule = opacity 0.9 0.9, float = false, no_initial_focus = true

#layerrule = noanim, ^(quickshell)$

source = ~/.config/hypr/windowRules.conf

# ==================
# KEYBINDINGS
# ==================
$mod = SUPER

# === Application Launchers ===
bind = $mod, Return, exec, kitty
bind = $mod SHIFT, Return, exec, alacritty
bind = $mod, space, exec, dms ipc call spotlight toggle
bind = $mod, V, exec, dms ipc call clipboard toggle
bind = CTRL SHIFT, escape, exec, dms ipc call processlist focusOrToggle
bind = $mod, comma, exec, dms ipc call settings focusOrToggle
bind = $mod, N, exec, dms ipc call notifications toggle
bind = $mod SHIFT, N, exec, dms ipc call notepad toggle
bind = $mod, Y, exec, dms ipc call dankdash wallpaper
bind = $mod, TAB, exec, dms ipc call hypr toggleOverview
bind = $mod, B, exec, firefox
bind = $mod, U, exec, unityhub

bind = ALT, Tab, workspace, previous

# === Cheat sheet
bind = $mod SHIFT, Slash, exec, dms ipc call keybinds toggle hyprland

# === Security ===
bind = $mod ALT, L, exec, dms ipc call lock lock
bind = $mod SHIFT, E, exit
bind = CTRL ALT, Delete, exec, dms ipc call processlist focusOrToggle

# === Audio Controls ===
bindel = , XF86AudioRaiseVolume, exec, dms ipc call audio increment 3
bindel = , XF86AudioLowerVolume, exec, dms ipc call audio decrement 3
bindl = , XF86AudioMute, exec, dms ipc call audio mute
bindl = , XF86AudioMicMute, exec, dms ipc call audio micmute

# === Brightness Controls ===
bindel = , XF86MonBrightnessUp, exec, dms ipc call brightness increment 5 ""
bindel = , XF86MonBrightnessDown, exec, dms ipc call brightness decrement 5 ""

# === Window Management ===
bind = $mod, Q, killactive
bind = $mod, F, fullscreen, 0
bind = $mod SHIFT, F, fullscreen, 1
bind = $mod SHIFT, T, togglefloating
bind = $mod, W, togglegroup



# === Focus Navigation ===

#hyprlang if scroll

# bind = $mod, left, layoutmsg, focus l
# bind = $mod, down, layoutmsg, focus d
# bind = $mod, up, layoutmsg, focus u
# bind = $mod, right, layoutmsg, focus r

# hyprlang endif

#hyprlang if !scroll

#bind = $mod, left, cyclenext, prev, l
bind = $mod, left, movefocus, l
bind = $mod, down, movefocus, d
bind = $mod, up, movefocus, u
bind = $mod, right, movefocus, r
#bind = $mod, right, cyclenext, r
bind = $mod, H, movefocus, l
bind = $mod, J, movefocus, d
bind = $mod, K, movefocus, u
bind = $mod, L, movefocus, r

#hyprlang endif


# === Window Movement ===

#hyprlang if scroll

bind = $mod SHIFT, left, layoutmsg, movewindowto l
bind = $mod SHIFT, down, layoutmsg, movewindowto d
bind = $mod SHIFT, up, layoutmsg, movewindowto u
bind = $mod SHIFT, right, layoutmsg, movewindowto r
bind = $mod SHIFT, period, layoutmsg, promote

# hyprlang endif

#hyprlang if !scroll

bind = $mod SHIFT, left, movewindow, l
bind = $mod SHIFT, down, movewindow, d
bind = $mod SHIFT, up, movewindow, u
bind = $mod SHIFT, right, movewindow, r
bind = $mod SHIFT, H, movewindow, l
bind = $mod SHIFT, J, movewindow, d
bind = $mod SHIFT, K, movewindow, u
bind = $mod SHIFT, L, movewindow, r

#hyprlang endif





# === Column Navigation ===
bind = $mod, Home, focuswindow, first
bind = $mod, End, focuswindow, last

# === Monitor Navigation ===
bind = $mod CTRL, left, focusmonitor, l
bind = $mod CTRL, right, focusmonitor, r
bind = $mod CTRL, H, focusmonitor, l
bind = $mod CTRL, J, focusmonitor, d
bind = $mod CTRL, K, focusmonitor, u
bind = $mod CTRL, L, focusmonitor, r

# === Move to Monitor ===
bind = $mod SHIFT CTRL, left, movewindow, mon:l
bind = $mod SHIFT CTRL, down, movewindow, mon:d
bind = $mod SHIFT CTRL, up, movewindow, mon:u
bind = $mod SHIFT CTRL, right, movewindow, mon:r
bind = $mod SHIFT CTRL, H, movewindow, mon:l
bind = $mod SHIFT CTRL, J, movewindow, mon:d
bind = $mod SHIFT CTRL, K, movewindow, mon:u
bind = $mod SHIFT CTRL, L, movewindow, mon:r

# === Workspace Navigation ===
bind = $mod, Page_Down, split:workspace, e+1
bind = $mod, Page_Up, split:workspace, e-1
bind = $mod, U, split:workspace, e+1
bind = $mod, I, split:workspace, e-1
bind = $mod CTRL, down, split:movetoworkspace, e+1
bind = $mod CTRL, up, split:movetoworkspace, e-1
bind = $mod CTRL, U, split:movetoworkspace, e+1
bind = $mod CTRL, I, split:movetoworkspace, e-1

# === Move Workspaces ===
bind = $mod SHIFT, Page_Down, split:movetoworkspace, e+1
bind = $mod SHIFT, Page_Up, split:movetoworkspace, e-1
bind = $mod SHIFT, U, split:movetoworkspace, e+1
bind = $mod SHIFT, I, split:movetoworkspace, e-1

# Move workspace to monitor in direction
# bind = $mod CTRL ALT, left, moveworkspacetomonitor, l
# bind = $mod CTRL ALT, right, moveworkspacetomonitor, r

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mod, mouse:272, movewindow
bindm = $mod, mouse:273, resizewindow

# === Mouse Wheel Navigation ===
bind = $mod, mouse_down, split:workspace, e-1
bind = $mod, mouse_up, split:workspace, e+1
bind = $mod CTRL, mouse_down, split:movetoworkspace, e+1
bind = $mod CTRL, mouse_up, split:movetoworkspace, e-1

# === Numbered Workspaces ===
bind = $mod, 1, split:workspace, 1
bind = $mod, 2, split:workspace, 2
bind = $mod, 3, split:workspace, 3
bind = $mod, 4, split:workspace, 4
bind = $mod, 5, split:workspace, 5
bind = $mod, 6, split:workspace, 6
bind = $mod, 7, split:workspace, 7
bind = $mod, 8, split:workspace, 8
bind = $mod, 9, split:workspace, 9

# === Move to Numbered Workspaces ===
bind = $mod SHIFT, 1, split:movetoworkspace, 1
bind = $mod SHIFT, 2, split:movetoworkspace, 2
bind = $mod SHIFT, 3, split:movetoworkspace, 3
bind = $mod SHIFT, 4, split:movetoworkspace, 4
bind = $mod SHIFT, 5, split:movetoworkspace, 5
bind = $mod SHIFT, 6, split:movetoworkspace, 6
bind = $mod SHIFT, 7, split:movetoworkspace, 7
bind = $mod SHIFT, 8, split:movetoworkspace, 8
bind = $mod SHIFT, 9, split:movetoworkspace, 9

# === Column Management ===
bind = $mod, bracketleft, layoutmsg, preselect l
bind = $mod, bracketright, layoutmsg, preselect r

# === Sizing & Layout ===
bind = $mod, G, layoutmsg, togglesplit
bind = $mod CTRL, F, resizeactive, exact 100%

# === Move/resize windows with mainMod + LMB/RMB and dragging ===
bindmd = $mod, mouse:272, Move window, movewindow
bindmd = $mod, mouse:273, Resize window, resizewindow

# === Move/resize windows with mainMod + LMB/RMB and dragging ===
bindd = $mod, code:20, Expand window left, resizeactive, -100 0
bindd = $mod, code:21, Shrink window left, resizeactive, 100 0

# === Manual Sizing ===
binde = $mod ALT, End, resizeactive, -10% 0
binde = $mod ALT, Home, resizeactive, 10% 0
binde = $mod ALT, Prior, resizeactive, 0 -10%
binde = $mod ALT, Next, resizeactive, 0 10%

binde = $mod ALT, Left, resizeactive, -10% 0
binde = $mod ALT, Right, resizeactive, 10% 0
binde = $mod ALT, Up, resizeactive, 0 -10%
binde = $mod ALT, Down, resizeactive, 0 10%


binde = $mod ALT, Left, layoutmsg, colresize -conf
binde = $mod ALT, Right, layoutmsg, colresize +conf
binde = $mod, E, layoutmsg, colresize 1.0
binde = $mod, X, layoutmsg, colresize +conf

# === Screenshots ===
bind = , Print, exec, dms screenshot
bind = CTRL, Print, exec, dms screenshot full
bind = ALT, Print, exec, dms screenshot window

# === System Controls ===
bind = $mod SHIFT, P, dpms, toggle

bind = $mod, I, exec, dms ipc call keybinds toggle hyprland
bind = $mod, P, exec, dms ipc call notepad toggle

bind = $mod SHIFT, C, exec, kitty -e bash -c 'hyprctl clients -j; echo "Press any key to exit.."; read -n1'
